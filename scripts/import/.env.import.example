# .env.import — kopier til «.env.import» og fyll inn. ALDRI sjekk .env.import inn i git.
# Uten denne fila skrives INGENTING (tørrmodus er standard, fail-closed).

# Peker på KOPI-basen (aldri prod/Supabase-direkte). Kreves for --skriv.
IMPORT_DATABASE_URL=postgresql://BRUKER:PASS@HOST:5432/DBNAVN

# ALLOWLIST (kommaseparert) av tillatte Supabase-prosjektreferanser. Importen avviser HARDT alt som
# ikke står her — tom/manglende liste = ingenting tillatt (fail-closed). Legg inn øvingskopiens ref.
# Prod-referansen skal ALDRI stå her, heller ikke utkommentert (importsperren stopper hardt hvis den
# forekommer noe sted i .env.import). Godkjenn en ny kopi-base ved å legge ref-en til her.
IMPORT_TILLATTE_REF=

# Eksport-zip (kan også gis med --zip). Kreves for video-fase2 --skriv.
IMPORT_ZIP=/Users/kjartaneide/Desktop/Høst 2026/trivselslederno_Full_Export_240826.zip

# Bunny.net — kreves for video-fase2 --skriv (fase 2).
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
